KAAIRBePVLVdQAgAA", "media_id": "2090712018734997504", "media_info": {"__typename": "ApiImage", "color_info": {"palette": [{"percentage": 99.36, "rgb": {"blue": 251, "green": 251, "red": 251}}, {"percentage": 0.21, "rgb": {"blue": 247, "green": 168, "red": 115}}, {"percentage": 0.14, "rgb": {"blue": 189, "green": 202, "red": 119}}, {"percentage": 0.13, "rgb": {"blue": 83, "green": 144, "red": 240}}]}, "original_img_height": 504, "original_img_url": "https://pbs.twimg.com/media/HQOzgQRW4AAIIH0.jpg", "original_img_width": 1326}, "media_key": "3_2090712018734997504"}]}, "twitter_card": "tweet", "color": null, "provider": "twitter", "reposted_by": null}, "source": "Twitter Web App", "twitter_card": "player", "color": null, "provider": "twitter", "reposted_by": null}