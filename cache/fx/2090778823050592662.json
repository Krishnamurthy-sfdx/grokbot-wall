: "https://video.twimg.com/amplify_video/2090778364600623106/vid/avc1/1120x720/sa76nfeKhTPHb9EG.mp4?tag=29", "bitrate": 2176000, "content_type": "video/mp4"}]}]}, "quote": {"url": "https://x.com/zodchiii/status/2090743067095552094", "id": "2090743067095552094", "text": "", "raw_text": {"text": "https://t.co/NyKpCSt2lI", "display_text_range": [0, 23], "facets": []}, "author": {"screen_name": "zodchiii", "url": "https://x.com/zodchiii", "id": "1226636978256564226", "followers": 25722, "following": 364, "likes": 9847, "media_count": 736, "name": "darkzodchi", "description": "ai & finance entrepreneur \u2022 @zscdao member \u2022 sharing what I learn", "raw_description": {"text": "ai & finance entrepreneur \u2022 @zscdao member \u2022 sharing what I learn", "facets": []}, "location": "", "banner_url": "https://pbs.twimg.com/profile_banners/1226636978256564226/1767877872", "avatar_url": "https://pbs.twimg.com/profile_images/1999509933302124544/ABxY9N7S_200x200.jpg", "joined": "Sun Feb 09 22:40:28 +0000 2020", "protected": false, "website": {"url": "https://t.me/zodchixquant", "display_url": "t.me/zodchixquant"}, "verification": {"verified": true, "verified_at": null, "type": "individual"}, "avatar_color": null}, "replies": 4, "retweets": 16, "likes": 162, "bookmarks": 635, "quotes": 5, "created_at": "Fri Aug 21 10:09:25 +0000 2026", "created_timestamp": 1787306965, "possibly_sensitive": false, "views": 170445, "is_note_tweet": false, "community_note": null, "lang": null, "replying_to": null, "replying_to_status": null, "source": "Twitter Web App", "article": {"created_at": "2026-08-21T10:09:25.000Z", "modified_at": "2026-08-21T10:09:25.000Z", "id": "2090710773194432512", "title": "The 10 Grok Bots Everyone Should Build First (Exact Descriptions Inside) ", "preview_text": "Grok Bot lets you run dozens of bots. Most people build one, poke at it for twenty minutes, and cancel.\nInside: 10 role descriptions you can paste as-is, the approval line every one of them needs, and", "cover_media": {"id": "QXBpTWVkaWE6DAAFCgABHQO1mRgWIAAKAAIRBePVLVdQAgAA", "media_id": "2090714321168769024", "media_info": {"__typename": "ApiImage", "color_info": {"palette": [{"percentage": 93.7, "rgb": {"blue": 233, "green": 241, "red": 245}}, {"percentage": 1.26, "rgb": {"blue": 79, "green": 115, "red": 198}}, {"percentage": 1, "rgb": {"blue": 63, "green": 110, "red": 64}}, {"percentage": 1, "rgb": {"blue": 36, "green": 110, "red": 156}}, {"percentage": 0.93, "rgb": {"blue": 159, "green": 81, "red": 125}}]}, "original_img_height": 875, "original_img_url": "https://pbs.twimg.com/media/HQO1mRgWIAAcdZr.jpg", "original_img_width": 2188}, "media_key": "3_2090714321168769024"}, "content": {"blocks": [{"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "bcj62", "text": "Grok Bot lets you run dozens of bots. Most people build one, poke at it for twenty minutes, and cancel.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 6, "offset": 0, "style": "Bold"}], "key": "909ka", "text": "Inside: 10 role descriptions you can paste as-is, the approval line every one of them needs, and the order to build them in.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "2qo3j", "text": "Get the first three right and the other seven take ten minutes each.", "type": "unstyled"}, {"data": {}, "entityRanges": [{"key": 0, "length": 1, "offset": 22}], "inlineStyleRanges": [{"length": 23, "offset": 0, "style": "Bold"}], "key": "2j7nv", "text": "Here's the full setup \ud83d\udc47", "type": "unstyled"}, {"data": {"urls": [{"fromIndex": 83, "text": "https://t.me/zodchixquant", "toIndex": 108}]}, "entityRanges": [{"key": 1, "length": 1, "offset": 109}], "inlineStyleRanges": [{"length": 18, "offset": 0, "style": "Bold"}], "key": "fubdg", "text": "Before we dive in, I share daily notes on AI & vibe coding in my Telegram channel: https://t.me/zodchixquant \ud83e\udde0", "type": "unstyled"}, {"data": {}, "entityRanges": [{"key": 2, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "1unre", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "dgk5h", "text": "A bot is its description field, nothing else", "type": "header-two"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "7rv3j", "text": "No config file, no repo, no YAML. You get a name and a text box.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "6150q", "text": "Whatever you type in that box is the bot. Ten bots with empty descriptions behave like one bot you renamed ten times.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "9uqdv", "text": "One thing to know before you connect anything: ten bots is an org chart, not a security boundary.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "ctntt", "text": "Per xAI's team docs, all your bots share one cloud computer. Same files, same logins. Your research bot can reach whatever your inbox bot can.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "fmunv", "text": "So the roster buys you routing, not isolation. Connect accordingly.", "type": "unstyled"}, {"data": {}, "entityRanges": [{"key": 3, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "6vh7h", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "9nbl0", "text": "1. Chief of Staff", "type": "header-two"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "cboui", "text": "Your only entry point. You talk to this one, it talks to the other nine.", "type": "unstyled"}, {"data": {}, "entityRanges": [{"key": 4, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "899uv", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 116, "offset": 15, "style": "Italic"}], "key": "bu4gq", "text": "First message: Read my calendar for the next five days and my unread inbox, then give me a one page brief on what needs a decision.", "type": "unstyled"}, {"data": {}, "entityRanges": [{"key": 5, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "p4e2", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "b5620", "text": "2. Inbox Triage", "type": "header-two"}, {"data": {}, "entityRanges": [{"key": 6, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "2mia6", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [{"key": 7, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "7qg5h", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [{"key": 8, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "4k9ss", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "7p3qs", "text": "3. Calendar Prep", "type": "header-two"}, {"data": {}, "entityRanges": [{"key": 9, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "1kagj", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "9db1h", "text": "4. Researcher", "type": "header-two"}, {"data": {}, "entityRanges": [{"key": 10, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "dfl99", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "bacdc", "text": "5. Competitor Watch", "type": "header-two"}, {"data": {}, "entityRanges": [{"key": 11, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "eg6eg", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "3j758", "text": "6. Hook Writer", "type": "header-two"}, {"data": {}, "entityRanges": [{"key": 12, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "dr8ri", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "ind7", "text": "7. Draft Writer", "type": "header-two"}, {"data": {}, "entityRanges": [{"key": 13, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "8j9hv", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "9n11f", "text": "8. Growth Desk", "type": "header-two"}, {"data": {}, "entityRanges": [{"key": 14, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "4bc9i", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "8g158", "text": "9. Ledger", "type": "header-two"}, {"data": {}, "entityRanges": [{"key": 15, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "8s8fb", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "emb7d", "text": "10. Support Draft", "type": "header-two"}, {"data": {}, "entityRanges": [{"key": 16, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "1btir", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "cb7a5", "text": "The order that works", "type": "header-two"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "fbc43", "text": "Ten bots on day one gives you ten unreliable bots. Build in this sequence and each one gets three real runs before the next arrives.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 6, "offset": 0, "style": "Bold"}], "key": "5v8i6", "text": "Day 1. Chief of Staff, Inbox Triage, Calendar Prep. This is the morning that saves you the most time, so it earns the subscription first.", "type": "unordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 6, "offset": 0, "style": "Bold"}], "key": "ar0di", "text": "Day 3. Researcher and Hook Writer. Both feed the writer, so they come before it.", "type": "unordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 6, "offset": 0, "style": "Bold"}], "key": "ce8fg", "text": "Day 5. Draft Writer and Competitor Watch.", "type": "unordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 7, "offset": 0, "style": "Bold"}], "key": "7c9bg", "text": "Week 2. Growth Desk, Ledger, Support Draft, once the first seven have stopped surprising you.", "type": "unordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "9kcks", "text": "What this actually saves you", "type": "header-two"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "17mqr", "text": "Do the arithmetic before you trust the vibe. Take one bot, time the task by hand once, and use this:", "type": "unstyled"}, {"data": {}, "entityRanges": [{"key": 17, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "7m5o", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "cjd43", "text": "Inbox Triage on a real inbox runs about 18 minutes by hand, five days a week, which is 1.5 hours. Calendar Prep at 9 minutes across four meetings is 0.6 hours. Competitor Watch at 40 minutes weekly is 0.7 hours. Three bots, roughly 2.8 hours a week.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "4pn6f", "text": "At the individual tier, which xAI lists in the $120 to $300 per month range depending on plan, 2.8 hours a week works out to about 12 hours a month. Check the number that matches your own plan and decide whether your hour is worth more than that.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "7ppp6", "text": "Common mistakes", "type": "header-two"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 51, "offset": 0, "style": "Bold"}], "key": "3n2ub", "text": "Leaving the description empty and steering in chat. The chat resets, the description does not. A bot with no description drifts into a general helper within a week and you rebuild it from scratch.", "type": "unordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 58, "offset": 0, "style": "Bold"}], "key": "3dnda", "text": "Skipping the approval line on the bots that seem harmless. The research bot is the one that reads hostile web pages. It needs the line more than the inbox bot does.", "type": "unordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 34, "offset": 0, "style": "Bold"}], "key": "8v795", "text": "Letting two bots own the same job. Hook Writer and Draft Writer both touching titles means you get two answers and no decision. One job, one owner.", "type": "unordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 32, "offset": 0, "style": "Bold"}], "key": "5ud3h", "text": "Talking to specialists directly. The moment you message the Researcher yourself, the Chief of Staff no longer knows what work exists, and the brief starts missing things.", "type": "unordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 47, "offset": 0, "style": "Bold"}], "key": "bl606", "text": "Treating separate bots as separate permissions. They share one computer and one set of sessions. Connect on the assumption that any bot can reach anything you connected.", "type": "unordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "3fpie", "text": "The 20-minute setup", "type": "header-two"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "c03cp", "text": "Create Chief of Staff, paste its description and the approval block (4 min)", "type": "ordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "5op0n", "text": "Create Inbox Triage and Calendar Prep the same way (6 min)", "type": "ordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "1i573", "text": "Connect four things only: inbox, calendar, news, one publishing channel (5 min)", "type": "ordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "3ihap", "text": "Send each bot its first message and read the full output, not the summary (5 min)", "type": "ordered-list-item"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "6iprf", "text": "Then stop. Do not add bot four until the first three have run three mornings without you correcting them.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "b5ip5", "text": "The roster is not what makes this work. The descriptions are, and each one takes about ninety seconds to write properly.", "type": "unstyled"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [{"length": 19, "offset": 0, "style": "Bold"}], "key": "2qin", "text": "Thanks for reading!", "type": "unstyled"}, {"data": {"urls": [{"fromIndex": 64, "text": "https://t.me/zodchixquant", "toIndex": 89}]}, "entityRanges": [{"key": 18, "length": 1, "offset": 90}], "inlineStyleRanges": [{"length": 91, "offset": 0, "style": "Bold"}], "key": "7a63k", "text": "I share daily notes on AI & vibe coding in my Telegram channel: https://t.me/zodchixquant \ud83e\udde0", "type": "unstyled"}, {"data": {}, "entityRanges": [{"key": 19, "length": 1, "offset": 0}], "inlineStyleRanges": [], "key": "bpea5", "text": " ", "type": "atomic"}, {"data": {}, "entityRanges": [], "inlineStyleRanges": [], "key": "ajioq", "text": "", "type": "unstyled"}], "entityMap": [{"key": "12", "value": {"data": {"entityKey": "fc59154a-74c5-4694-b0b3-4466cd095b78", "markdown": "```markdown\nGiven a draft or a link, return three opening lines and three title\nvariants. Nothing else, no explanation of your choices.\nRules: no em dashes, no choppy two-word fragments, specific numbers\nover round ones, speak directly to the reader.\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "8", "value": {"data": {"caption": "Second step.", "entityKey": "da1b0edc-e5cb-4c34-a5cd-0a62ab786c1f", "mediaItems": [{"localMediaId": "11", "mediaCategory": "DraftTweetImage", "mediaId": "2090712321156952064"}]}, "mutability": "Immutable", "type": "MEDIA"}}, {"key": "19", "value": {"data": {"entityKey": "8d4a7aae-b0f4-4dd7-968f-e75223641083", "mediaItems": [{"localMediaId": "13", "mediaCategory": "DraftTweetImage", "mediaId": "2090713138077249536"}]}, "mutability": "Immutable", "type": "MEDIA"}}, {"key": "4", "value": {"data": {"entityKey": "3a043a0a-4f43-4465-a3d3-1d69bd703c49", "markdown": "```markdown\nYou are my Chief of Staff and the single front door to my bot roster.\nYou do not do specialist work yourself. You dispatch it, wait, and\nreport one result. Never hand me raw output from another bot.\nOne job per dispatch, with the finish line stated up front.\nIf two bots disagree, resolve it before it reaches me and tell me\nwhat the disagreement was.\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "15", "value": {"data": {"entityKey": "e845f058-93c8-429d-abec-afafa45be429", "markdown": "```markdown\nFind invoices and receipts in my inbox from the last seven days,\ndownload the attachments, and file them by month.\nList anything unpaid with the due date. Flag anything that looks\nlike a duplicate charge instead of filing it silently.\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "11", "value": {"data": {"entityKey": "ba128555-1f67-473e-b95d-f704134df862", "markdown": "```markdown\nOnce a week, check my competitor list for pricing changes, launches,\nand hires. Report only what changed since last week.\nIf a source is unreachable, report the failure. Never reuse last\nweek's data and present it as current.\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "9", "value": {"data": {"entityKey": "f6968f07-1351-4f22-b736-9cabc93d5f29", "markdown": "```markdown\nNinety minutes before every external meeting, pull what I need: who\nthey are, what we last discussed, what they asked for, and what is\nstill open on my side. Three bullets, nothing longer.\nIf we have never met, say so instead of inventing history.\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "13", "value": {"data": {"entityKey": "8097b69a-f86f-4868-a61f-8eb99985bbd0", "markdown": "```markdown\nTurn a research brief into a draft in my voice: direct, plain, no em\ndashes, no filler openers.\nOnly use facts that appear in the brief. If the brief is thin, say\nwhich section is thin and stop rather than padding it.\nSave to Drafts. Never publish.\n\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "16", "value": {"data": {"entityKey": "316e9df8-9ca3-4dc7-a4bc-71c53e8f805a", "markdown": "```markdown\nRead inbound customer messages and draft a reply to each in a calm,\nplain tone.\nAnything involving a refund, a legal question, or an angry customer\ngoes to me with a note and no draft. Never send.\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "5", "value": {"data": {"entityKey": "e93f0faf-f91c-488e-818d-e0747fbf7b84", "mediaItems": [{"localMediaId": "5", "mediaCategory": "AmplifyVideo", "mediaId": "2090711712068440064"}]}, "mutability": "Immutable", "type": "MEDIA"}}, {"key": "10", "value": {"data": {"entityKey": "8892136e-3b30-4d4a-b507-0fd7b9984d77", "markdown": "```markdown\nGiven a topic, produce a briefing with five verified facts, three\nsources with links, and two counter-arguments.\nEvery number, date, and name gets a source. If you cannot verify a\nclaim, list it under Unverified rather than dropping it or guessing.\nNever put words in quotation marks unless you found that exact\nsentence in a source you can link.\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "6", "value": {"data": {"entityKey": "b4788382-8a16-406e-9b86-1b8d92565c50", "markdown": "```markdown\nYou read my inbox and sort it into three buckets: needs a human reply,\nneeds a decision from me, and ignore. For anything in the first bucket,\nwrite the reply and leave it as a draft. \nNever send.\n\nReport as a list of names and one line each. No summaries of the\nsummaries.\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "1", "value": {"data": {"url": "https://abs.twimg.com/emoji/v2/svg/1f9e0.svg"}, "mutability": "Immutable", "type": "TWEMOJI"}}, {"key": "17", "value": {"data": {"entityKey": "cc75926d-dbd1-4ad9-9e90-5abe0d0dd22f", "markdown": "```\nminutes per run x runs per week / 60 = hours saved per week\n\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "14", "value": {"data": {"entityKey": "f0f738db-c328-4ce8-b899-9236388d2ac8", "markdown": "```markdown\nPull the numbers on what I published: impressions, saves, replies,\nand click-through, per post, for the last seven days.\nReport the three that beat my median and the three that missed it,\nwith the format each one used. No advice unless I ask for it.\n```"}, "mutability": "Mutable", "type": "MARKDOWN"}}, {"key": "0", "value": {"data": {"url": "https://abs.twimg.com/emoji/v2/svg/1f447.svg"}, "mutability": "Immutable", "type": "TWEMOJI"}}, {"key": "2", "value": {"data": {"entityKey": "d14d142e-e911-4eaa-b09e-0800f6d12f97", "mediaItems": [{"localMediaId": "1", "mediaCategory": "DraftTweetImage", "mediaId": "2090711054863020033"}]}, "mutability": "Immutable", "type": "MEDIA"}}, {"key": "18", "value": {"data": {"url": "https://abs.twimg.com/emoji/v2/svg/1f9e0.svg"}, "mutability": "Immutable", "type": "TWEMOJI"}}, {"key": "7", "value": {"data": {"caption": "First step.", "entityKey": "47d17fe4-fb41-402e-b07f-ea212bf2a3d7", "mediaItems": [{"localMediaId": "7", "mediaCategory": "DraftTweetImage", "mediaId": "2090712018734997504"}]}, "mutability": "Immutable", "type": "MEDIA"}}, {"key": "3", "value": {"data": {"entityKey": "51bdd337-feaa-42ef-8309-e28c54b06973", "mediaItems": [{"localMediaId": "3", "mediaCategory": "DraftTweetImage", "mediaId": "2090711188279603200"}]}, "mutability": "Immutable", "type": "MEDIA"}}]}, "media_entities": [{"id": "QXBpTWVkaWE6DAAFCgABHQOzx24XsAAKAAIRBePVLVdQAgAA", "media